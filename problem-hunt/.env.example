# Public browser configuration only. Never put service-role keys or JWT signing secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional sanitized error monitoring; replay and performance tracing are disabled.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Leave off for core launch. Enable only after delivery is deployed and verified.
VITE_REPLY_NOTIFICATIONS_ENABLED=false
# Public, monitored privacy/support channel: mailto:address or an HTTPS contact page.
VITE_SUPPORT_CONTACT=
